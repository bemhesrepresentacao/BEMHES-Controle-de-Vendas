<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>BEMHES • Controle de Vendas</title>
<style>
:root{--nav:#0b1f3a;--pri:#1769e0;--bg:#f5f7fb;--card:#fff;--txt:#172033;--mut:#64748b;--line:#e5e7eb;--ok:#16a34a;--warn:#d97706;--bad:#dc2626}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--txt)}
aside{position:fixed;left:0;top:0;bottom:0;width:235px;background:var(--nav);color:#fff;padding:20px 14px;z-index:4}.brand{font-size:20px;font-weight:800;padding:5px 10px 25px}.brand b{color:#48a8ff}
nav button{display:block;width:100%;border:0;background:none;color:#cbd5e1;text-align:left;padding:12px;border-radius:9px;margin:4px 0;font-size:14px;cursor:pointer}nav button:hover,nav button.sel{background:#1557bd;color:white}
main{margin-left:235px;padding:24px;max-width:1500px}.page{display:none}.page.on{display:block}.head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:18px}h1{margin:0;font-size:26px}.mut{color:var(--mut);font-size:14px;margin-top:4px}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.card,.box{background:var(--card);border:1px solid var(--line);border-radius:13px;padding:17px;box-shadow:0 2px 8px #0f172a0b}.kpi{font-size:25px;font-weight:800;margin-top:8px}.label{color:var(--mut);font-size:13px}
.grid{display:grid;grid-template-columns:1.6fr 1fr;gap:16px}.box h2{font-size:17px;margin:0 0 14px}
.btn{border:0;border-radius:8px;background:var(--pri);color:#fff;padding:10px 14px;font-weight:700;cursor:pointer}.btn.ok{background:var(--ok)}.btn.gray{background:#e2e8f0;color:#334155}.btn.red{background:var(--bad)}.btn.sm{padding:6px 9px;font-size:12px}.tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:13px}.search,input,select,textarea{border:1px solid var(--line);border-radius:8px;padding:10px;background:#fff;width:100%}.search{width:260px}
table{border-collapse:collapse;width:100%}th,td{padding:10px 7px;border-bottom:1px solid var(--line);font-size:13px;text-align:left}th{color:var(--mut);font-size:11px;text-transform:uppercase}
.badge{display:inline-block;padding:4px 8px;border-radius:20px;background:#dcfce7;color:#166534;font-size:11px}.badge.warn{background:#fef3c7;color:#92400e}.badge.bad{background:#fee2e2;color:#991b1b}
.form{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.fg label{display:block;color:var(--mut);font-size:12px;margin-bottom:5px}.full{grid-column:1/-1}
.modal{display:none;position:fixed;inset:0;background:#0008;align-items:center;justify-content:center;padding:14px;z-index:10}.modal.show{display:flex}.modalbox{background:#fff;border-radius:14px;width:min(850px,100%);max-height:92vh;overflow:auto;padding:22px}.modalbox h2{margin-top:0}
.items{margin-top:15px}.item{display:grid;grid-template-columns:2fr .65fr 1fr 35px;gap:7px;margin:7px 0}.total{text-align:right;font-size:22px;font-weight:800;margin:14px 0}.login{position:fixed;inset:0;background:linear-gradient(135deg,#071a33,#1769e0);display:flex;align-items:center;justify-content:center;z-index:20}.loginbox{background:#fff;width:min(390px,92%);padding:28px;border-radius:16px}.loginbox h1{text-align:center;margin-bottom:20px}.loginbox input{margin-bottom:10px}.loginbox small{color:var(--mut)}
canvas{width:100%;height:220px;border:1px solid var(--line);border-radius:10px}
@media(max-width:900px){aside{width:66px;padding:14px 7px}.brand{font-size:0;text-align:center}.brand:after{content:"BV";font-size:19px}.brand b{display:none}nav button{font-size:0;text-align:center}nav button:first-letter{font-size:20px}main{margin-left:66px;padding:14px}.cards{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}}
@media(max-width:560px){.cards{grid-template-columns:1fr 1fr}.form{grid-template-columns:1fr}.full{grid-column:auto}.item{grid-template-columns:1fr 65px 90px 35px}.search{width:100%}h1{font-size:21px}}
</style>
</head>
<body>
<div class="login" id="login"><div class="loginbox"><h1>BEMHES <span style="color:#1769e0">Vendas</span></h1><input id="user" placeholder="Usuário" value="admin"><input id="pass" type="password" placeholder="Senha" value="1234"><button class="btn" style="width:100%" onclick="enter()">Entrar</button><p><small>Demo: usuário <b>admin</b> / senha <b>1234</b></small></p></div></div>

<aside><div class="brand">BEMHES <b>Vendas</b></div><nav>
<button class="sel" onclick="go('dash',this)">📊 Dashboard</button>
<button onclick="go('clientes',this)">👥 Clientes</button>
<button onclick="go('produtos',this)">📦 Produtos</button>
<button onclick="go('vendas',this)">🛒 Vendas</button>
<button onclick="go('orcamentos',this)">📄 Orçamentos</button>
<button onclick="go('financeiro',this)">💰 Financeiro</button>
<button onclick="go('relatorios',this)">📈 Relatórios</button>
<button onclick="logout()">🚪 Sair</button>
</nav></aside>

<main>
<section id="dash" class="page on"><div class="head"><div><h1>Dashboard</h1><div class="mut">Visão geral do negócio</div></div><button class="btn" onclick="newSale()">+ Nova venda</button></div>
<div class="cards"><div class="card"><div class="label">Vendas</div><div id="kSales" class="kpi">R$ 0,00</div></div><div class="card"><div class="label">Recebido</div><div id="kPaid" class="kpi">R$ 0,00</div></div><div class="card"><div class="label">A receber</div><div id="kOpen" class="kpi">R$ 0,00</div></div><div class="card"><div class="label">Clientes</div><div id="kClients" class="kpi">0</div></div></div>
<div class="grid"><div class="box"><h2>Vendas recentes</h2><div id="dashSales"></div></div><div class="box"><h2>Indicadores</h2><p>Ticket médio: <b id="ticket">R$ 0,00</b></p><p>Produtos cadastrados: <b id="nProd">0</b></p><p>Estoque baixo: <b id="nLow">0</b></p><p>Orçamentos em aberto: <b id="nBud">0</b></p></div></div></section>

<section id="clientes" class="page"><div class="head"><div><h1>Clientes</h1><div class="mut">Cadastro comercial</div></div><button class="btn" onclick="clientModal()">+ Cliente</button></div><div class="box"><div class="tools"><input class="search" placeholder="Pesquisar..." oninput="renderClients(this.value)"></div><div id="clients"></div></div></section>
<section id="produtos" class="page"><div class="head"><div><h1>Produtos</h1><div class="mut">Produtos, preços e estoque</div></div><button class="btn" onclick="productModal()">+ Produto</button></div><div class="box"><div class="tools"><input class="search" placeholder="Pesquisar..." oninput="renderProducts(this.value)"></div><div id="products"></div></div></section>
<section id="vendas" class="page"><div class="head"><div><h1>Vendas</h1><div class="mut">Pedidos faturados</div></div><button class="btn" onclick="newSale()">+ Nova venda</button></div><div class="box"><div id="sales"></div></div></section>
<section id="orcamentos" class="page"><div class="head"><div><h1>Orçamentos</h1><div class="mut">Propostas comerciais</div></div><button class="btn" onclick="budgetModal()">+ Orçamento</button></div><div class="box"><div id="budgets"></div></div></section>
<section id="financeiro" class="page"><div class="head"><div><h1>Financeiro</h1><div class="mut">Contas a receber</div></div></div><div class="box"><div id="finance"></div></div></section>
<section id="relatorios" class="page"><div class="head"><div><h1>Relatórios</h1><div class="mut">Resumo de desempenho</div></div><button class="btn gray" onclick="exportData()">Exportar dados</button></div><div class="cards"><div class="card"><div class="label">Faturamento</div><div class="kpi" id="rTotal">R$ 0,00</div></div><div class="card"><div class="label">Custo estimado</div><div class="kpi" id="rCost">R$ 0,00</div></div><div class="card"><div class="label">Margem estimada</div><div class="kpi" id="rMargin">R$ 0,00</div></div><div class="card"><div class="label">Vendas</div><div class="kpi" id="rCount">0</div></div></div><div class="box"><h2>Produtos mais vendidos</h2><div id="rProducts"></div></div></section>
</main>

<div class="modal" id="modal"><div class="modalbox" id="modalContent"></div></div>
<script>
const KEY='bemhes_vendas_v2';
let db=JSON.parse(localStorage.getItem(KEY)||'null')||{clients:[],products:[],sales:[],budgets:[]};
const $=id=>document.getElementById(id), money=v=>(+v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}), uid=()=>Date.now()+Math.random();
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
function persist(){localStorage.setItem(KEY,JSON.stringify(db))}
function enter(){if(user.value==='admin'&&pass.value==='1234'){$('login').style.display='none';sessionStorage.login='1'}else alert('Usuário ou senha inválidos.')}
function logout(){sessionStorage.clear();$('login').style.display='flex'}
if(sessionStorage.login==='1')$('login').style.display='none';
function go(id,btn){document.querySelectorAll('.page').forEach(x=>x.classList.remove('on'));$(id).classList.add('on');document.querySelectorAll('nav button').forEach(x=>x.classList.remove('sel'));btn.classList.add('sel');render()}
function close(){ $('modal').classList.remove('show')}
function show(content){$('modalContent').innerHTML=content;$('modal').classList.add('show')}
function clientModal(){show(`<h2>Novo cliente</h2><form onsubmit="saveClient(event)"><div class="form"><div class="fg"><label>Nome / Razão Social</label><input id="cn" required></div><div class="fg"><label>CPF / CNPJ</label><input id="cd"></div><div class="fg"><label>WhatsApp</label><input id="cp"></div><div class="fg"><label>E-mail</label><input id="ce"></div><div class="fg"><label>Cidade</label><input id="cc"></div><div class="fg"><label>Vendedor</label><input id="cv"></div><div class="fg full"><label>Endereço</label><input id="ca"></div></div><br><button class="btn">Salvar</button> <button type="button" class="btn gray" onclick="close()">Cancelar</button></form>`)}
function saveClient(e){e.preventDefault();db.clients.push({id:uid(),name:cn.value,doc:cd.value,phone:cp.value,email:ce.value,city:cc.value,seller:cv.value,address:ca.value});persist();close();render()}
function productModal(){show(`<h2>Novo produto</h2><form onsubmit="saveProduct(event)"><div class="form"><div class="fg"><label>Produto</label><input id="pn" required></div><div class="fg"><label>Código</label><input id="pc"></div><div class="fg"><label>Preço de venda</label><input id="pp" type="number" step=".01" min="0" required></div><div class="fg"><label>Custo</label><input id="pco" type="number" step=".01" min="0"></div><div class="fg"><label>Estoque</label><input id="ps" type="number" step=".01" min="0" value="0"></div><div class="fg"><label>Estoque mínimo</label><input id="pm" type="number" step=".01" min="0" value="0"></div></div><br><button class="btn">Salvar</button> <button type="button" class="btn gray" onclick="close()">Cancelar</button></form>`)}
function saveProduct(e){e.preventDefault();db.products.push({id:uid(),name:pn.value,code:pc.value,price:+pp.value,cost:+pco.value||0,stock:+ps.value||0,min:+pm.value||0});persist();close();render()}
function newSale(){if(!db.clients.length||!db.products.length){alert('Cadastre clientes e produtos primeiro.');return}show(`<h2>Nova venda</h2><form onsubmit="saveSale(event)"><div class="form"><div class="fg"><label>Cliente</label><select id="sc">${db.clients.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('')}</select></div><div class="fg"><label>Pagamento</label><select id="sp"><option>Pix</option><option>Dinheiro</option><option>Cartão</option><option>Boleto</option><option>Transferência</option></select></div></div><div class="items"><div class="tools"><b>Itens da venda</b><button type="button" class="btn gray sm" onclick="addItem()">+ Item</button></div><div id="saleItems"></div></div><div class="total">Total: <span id="st">R$ 0,00</span></div><button class="btn ok">Finalizar venda</button> <button type="button" class="btn gray" onclick="close()">Cancelar</button></form>`);addItem()}
function addItem(){let d=document.createElement('div');d.className='item';d.innerHTML=`<select class="ip" onchange="calc()">${db.products.map(p=>`<option value="${p.id}">${esc(p.name)} — ${money(p.price)}</option>`).join('')}</select><input class="iq" type="number" min=".01" step=".01" value="1" oninput="calc()"><input class="iprice" type="number" step=".01" min="0" value="${db.products[0].price}" oninput="calc()"><button type="button" class="btn red sm" onclick="this.parentNode.remove();calc()">×</button>`;$('saleItems').appendChild(d)}
function calc(){let t=0;document.querySelectorAll('.item').forEach(x=>t+=(+x.querySelector('.iq').value||0)*(+x.querySelector('.iprice').value||0));$('st').textContent=money(t)}
function saveSale(e){e.preventDefault();let items=[],total=0;document.querySelectorAll('.item').forEach(x=>{let p=db.products.find(p=>p.id==x.querySelector('.ip').value),q=+x.querySelector('.iq').value,pr=+x.querySelector('.iprice').value;if(p&&q>0){items.push({productId:p.id,name:p.name,qty:q,price:pr,cost:p.cost});total+=q*pr;p.stock=Math.max(0,p.stock-q)}});db.sales.push({id:uid(),date:new Date().toISOString(),clientId:+sc.value,payment:sp.value,total,items,status:sp.value==='Boleto'?'Pendente':'Pago'});persist();close();render()}
function budgetModal(){if(!db.clients.length||!db.products.length){alert('Cadastre clientes e produtos primeiro.');return}show(`<h2>Novo orçamento</h2><form onsubmit="saveBudget(event)"><div class="form"><div class="fg"><label>Cliente</label><select id="bc">${db.clients.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('')}</select></div><div class="fg"><label>Validade</label><input id="bv" type="date"></div></div><div class="items"><div class="tools"><b>Itens</b><button type="button" class="btn gray sm" onclick="addBItem()">+ Item</button></div><div id="budgetItems"></div></div><div class="total">Total: <span id="bt">R$ 0,00</span></div><button class="btn">Salvar orçamento</button> <button type="button" class="btn gray" onclick="close()">Cancelar</button></form>`);addBItem()}
function addBItem(){let d=document.createElement('div');d.className='item';d.innerHTML=`<select class="bp" onchange="calcB()">${db.products.map(p=>`<option value="${p.id}">${esc(p.name)} — ${money(p.price)}</option>`).join('')}</select><input class="bq" type="number" min=".01" step=".01" value="1" oninput="calcB()"><input class="bprice" type="number" step=".01" min="0" value="${db.products[0].price}" oninput="calcB()"><button type="button" class="btn red sm" onclick="this.parentNode.remove();calcB()">×</button>`;$('budgetItems').appendChild(d)}
function calcB(){let t=0;document.querySelectorAll('#budgetItems .item').forEach(x=>t+=(+x.querySelector('.bq').value||0)*(+x.querySelector('.bprice').value||0));$('bt').textContent=money(t)}
function saveBudget(e){e.preventDefault();let items=[],total=0;document.querySelectorAll('#budgetItems .item').forEach(x=>{let p=db.products.find(p=>p.id==x.querySelector('.bp').value),q=+x.querySelector('.bq').value,pr=+x.querySelector('.bprice').value;items.push({name:p.name,qty:q,price:pr});total+=q*pr});db.budgets.push({id:uid(),date:new Date().toISOString(),validity:bv.value,clientId:+bc.value,total,items,status:'Aberto'});persist();close();render()}
function del(type,i){if(confirm('Excluir registro?')){db[type].splice(i,1);persist();render()}}
function clientName(id){return db.clients.find(c=>c.id==id)?.name||'—'}
function renderClients(q=''){q=q.toLowerCase();let a=db.clients.filter(c=>(c.name+c.doc+c.phone+c.city).toLowerCase().includes(q));$('clients').innerHTML=`<table><tr><th>Cliente</th><th>Documento</th><th>WhatsApp</th><th>Cidade</th><th>Vendedor</th><th></th></tr>${a.map(c=>`<tr><td><b>${esc(c.name)}</b></td><td>${esc(c.doc)}</td><td>${esc(c.phone)}</td><td>${esc(c.city)}</td><td>${esc(c.seller)}</td><td><button class="btn red sm" onclick="del('clients',${db.clients.indexOf(c)})">Excluir</button></td></tr>`).join('')}</table>`}
function renderProducts(q=''){q=q.toLowerCase();let a=db.products.filter(p=>(p.name+p.code).toLowerCase().includes(q));$('products').innerHTML=`<table><tr><th>Produto</th><th>Código</th><th>Preço</th><th>Custo</th><th>Estoque</th><th></th></tr>${a.map(p=>`<tr><td><b>${esc(p.name)}</b></td><td>${esc(p.code)}</td><td>${money(p.price)}</td><td>${money(p.cost)}</td><td>${p.stock<=p.min?'<span class="badge bad">'+p.stock+'</span>':'<span class="badge">'+p.stock+'</span>'}</td><td><button class="btn red sm" onclick="del('products',${db.products.indexOf(p)})">Excluir</button></td></tr>`).join('')}</table>`}
function renderSales(){$('sales').innerHTML=`<table><tr><th>Data</th><th>Cliente</th><th>Pagamento</th><th>Total</th><th>Status</th></tr>${db.sales.slice().reverse().map(s=>`<tr><td>${new Date(s.date).toLocaleDateString('pt-BR')}</td><td>${esc(clientName(s.clientId))}</td><td>${s.payment}</td><td><b>${money(s.total)}</b></td><td>${s.status==='Pago'?'<span class="badge">Pago</span>':'<span class="badge warn">Pendente</span>'}</td></tr>`).join('')}</table>`}
function renderBudgets(){$('budgets').innerHTML=db.budgets.length?`<table><tr><th>Data</th><th>Cliente</th><th>Validade</th><th>Total</th><th>Status</th></tr>${db.budgets.slice().reverse().map(b=>`<tr><td>${new Date(b.date).toLocaleDateString('pt-BR')}</td><td>${esc(clientName(b.clientId))}</td><td>${b.validity?new Date(b.validity+'T00:00').toLocaleDateString('pt-BR'):'—'}</td><td>${money(b.total)}</td><td><span class="badge warn">${b.status}</span></td></tr>`).join('')}</table>`:'<p>Nenhum orçamento.</p>'}
function renderFinance(){let a=db.sales.filter(s=>s.status!=='Pago');$('finance').innerHTML=a.length?`<table><tr><th>Cliente</th><th>Venda</th><th>Valor</th><th>Status</th></tr>${a.map(s=>`<tr><td>${esc(clientName(s.clientId))}</td><td>${new Date(s.date).toLocaleDateString('pt-BR')}</td><td>${money(s.total)}</td><td><span class="badge warn">Pendente</span></td></tr>`).join('')}</table>`:'<p>Não há contas pendentes.</p>'}
function renderDash(){let total=db.sales.reduce((a,s)=>a+s.total,0),paid=db.sales.filter(s=>s.status==='Pago').reduce((a,s)=>a+s.total,0);$('kSales').textContent=money(total);$('kPaid').textContent=money(paid);$('kOpen').textContent=money(total-paid);$('kClients').textContent=db.clients.length;$('ticket').textContent=money(db.sales.length?total/db.sales.length:0);$('nProd').textContent=db.products.length;$('nLow').textContent=db.products.filter(p=>p.stock<=p.min).length;$('nBud').textContent=db.budgets.filter(b=>b.status==='Aberto').length;$('dashSales').innerHTML=db.sales.length?`<table><tr><th>Cliente</th><th>Data</th><th>Total</th></tr>${db.sales.slice(-6).reverse().map(s=>`<tr><td>${esc(clientName(s.clientId))}</td><td>${new Date(s.date).toLocaleDateString('pt-BR')}</td><td>${money(s.total)}</td></tr>`).join('')}</table>`:'<p>Nenhuma venda registrada.</p>'}
function renderReports(){let total=db.sales.reduce((a,s)=>a+s.total,0),cost=db.sales.reduce((a,s)=>a+s.items.reduce((z,i)=>z+i.qty*i.cost,0),0);$('rTotal').textContent=money(total);$('rCost').textContent=money(cost);$('rMargin').textContent=money(total-cost);$('rCount').textContent=db.sales.length;let m={};db.sales.forEach(s=>s.items.forEach(i=>m[i.name]=(m[i.name]||0)+i.qty));$('rProducts').innerHTML=Object.entries(m).sort((a,b)=>b[1]-a[1]).map(x=>`<p>${esc(x[0])}: <b>${x[1]}</b> unidades</p>`).join('')||'<p>Sem vendas.</p>'}
function exportData(){let blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='backup_bemhes_vendas.json';a.click();URL.revokeObjectURL(a.href)}
function render(){renderDash();renderClients();renderProducts();renderSales();renderBudgets();renderFinance();renderReports()}
render();
</script>
</body></html>
